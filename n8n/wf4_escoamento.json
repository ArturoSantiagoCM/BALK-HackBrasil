{
  "name": "BALK WF4 Escoamento (melhor saída)",
  "nodes": [
    {
      "name": "Manual ou cron",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "name": "POST /logistics/plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/logistics/plan",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"producer_id\": 2, \"destination_id\": \"coop\"}"
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "BALK API key"
        }
      }
    },
    {
      "name": "Texto da saída",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "phone",
              "value": "+5500900000002",
              "type": "string"
            },
            {
              "name": "channel",
              "value": "whatsapp",
              "type": "string"
            },
            {
              "name": "text",
              "value": "={{$json.text}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        780,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "whatsapp",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "sms"
            }
          ]
        }
      }
    },
    {
      "name": "Enviar WhatsApp (Meta Cloud API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"text\",\"text\":{\"body\":{{JSON.stringify($json.text)}}}}"
      }
    },
    {
      "name": "Enviar SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1040,
        80
      ],
      "parameters": {
        "operation": "send",
        "from": "={{$env.TWILIO_FROM}}",
        "to": "={{$json.phone}}",
        "message": "={{$json.text}}"
      }
    },
    {
      "name": "Avisar equipe (erro)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.ALERT_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"BALK: falha em \" + $workflow.name}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual ou cron": {
      "main": [
        [
          {
            "node": "POST /logistics/plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /logistics/plan": {
      "main": [
        [
          {
            "node": "Texto da saída",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar equipe (erro)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Texto da saída": {
      "main": [
        [
          {
            "node": "Canal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Canal": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp (Meta Cloud API)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar SMS (Twilio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}