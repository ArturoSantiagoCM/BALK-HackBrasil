{
  "name": "BALK WF1 Entrada (cadastro por conversa)",
  "nodes": [
    {
      "name": "Webhook do canal",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "balk-entrada",
        "responseMode": "lastNode"
      }
    },
    {
      "name": "POST /conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/conversation",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"phone\": \"{{$json.body.phone}}\", \"text\": \"{{$json.body.text}}\", \"channel\": \"{{$json.body.channel}}\"}"
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "BALK API key"
        }
      }
    },
    {
      "name": "Resposta e relatórios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const r = $json; const w = $('Webhook do canal').item.json.body; const out = [];\nout.push({json: {phone: w.phone, channel: w.channel, text: r.reply}});\n(r.messages || []).filter(m => m.kind === 'report').forEach(m => out.push({json: {phone: w.phone, channel: w.channel, text: m.text}}));\nreturn out;"
      }
    },
    {
      "name": "Canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        780,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "whatsapp",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "sms"
            }
          ]
        }
      }
    },
    {
      "name": "Enviar WhatsApp (Meta Cloud API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"text\",\"text\":{\"body\":{{JSON.stringify($json.text)}}}}"
      }
    },
    {
      "name": "Enviar SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1040,
        80
      ],
      "parameters": {
        "operation": "send",
        "from": "={{$env.TWILIO_FROM}}",
        "to": "={{$json.phone}}",
        "message": "={{$json.text}}"
      }
    },
    {
      "name": "Avisar equipe (erro)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.ALERT_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"BALK: falha em \" + $workflow.name}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook do canal": {
      "main": [
        [
          {
            "node": "POST /conversation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /conversation": {
      "main": [
        [
          {
            "node": "Resposta e relatórios",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar equipe (erro)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resposta e relatórios": {
      "main": [
        [
          {
            "node": "Canal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Canal": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp (Meta Cloud API)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar SMS (Twilio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}