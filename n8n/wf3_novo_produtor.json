{
  "name": "BALK WF3 Novo produtor (CSV da cooperativa)",
  "nodes": [
    {
      "name": "Webhook /ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "balk-ingest",
        "responseMode": "lastNode"
      }
    },
    {
      "name": "POST /ingest/producers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/ingest/producers?analisar=true",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.body)}}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Um relatório por produtor",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "relatorios"
      }
    },
    {
      "name": "Texto do relatório",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        780,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "phone",
              "value": "={{$json.phone}}",
              "type": "string"
            },
            {
              "name": "channel",
              "value": "={{$json.channel}}",
              "type": "string"
            },
            {
              "name": "text",
              "value": "={{$json.messages[0].text}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "whatsapp",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "sms"
            }
          ]
        }
      }
    },
    {
      "name": "Enviar WhatsApp (Meta Cloud API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"text\",\"text\":{\"body\":{{JSON.stringify($json.text)}}}}"
      }
    },
    {
      "name": "Enviar SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1300,
        80
      ],
      "parameters": {
        "operation": "send",
        "from": "={{$env.TWILIO_FROM}}",
        "to": "={{$json.phone}}",
        "message": "={{$json.text}}"
      }
    },
    {
      "name": "Avisar equipe (erro)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.ALERT_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"BALK: falha em \" + $workflow.name}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    }
  ],
  "connections": {
    "Webhook /ingest": {
      "main": [
        [
          {
            "node": "POST /ingest/producers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /ingest/producers": {
      "main": [
        [
          {
            "node": "Um relatório por produtor",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar equipe (erro)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Um relatório por produtor": {
      "main": [
        [
          {
            "node": "Texto do relatório",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Texto do relatório": {
      "main": [
        [
          {
            "node": "Canal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Canal": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp (Meta Cloud API)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar SMS (Twilio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}