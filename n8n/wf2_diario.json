        [
          {
            "node": "Houve erro?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar equipe (erro)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Houve erro?": {
      "main": [
        [
          {
            "node": "Avisar equipe (erro)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "POST /jobs/purge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
