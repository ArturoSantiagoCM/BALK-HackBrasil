{
  "name": "BALK WF2 Diário (alertas do dia)",
  "nodes": [
    {
      "name": "Todo dia 06:05",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 6 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "POST /jobs/daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/jobs/daily",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "BALK API key"
        }
      }
    },
    {
      "name": "Houve erro?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.erros.length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      }
    },
    {
      "name": "POST /jobs/purge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/jobs/purge",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "BALK API key"
        }
      }
    },
    {
      "name": "Avisar equipe (erro)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.ALERT_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"BALK: falha em \" + $workflow.name}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Todo dia 06:05": {
      "main": [
        [
          {
            "node": "POST /jobs/daily",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /jobs/daily": {
