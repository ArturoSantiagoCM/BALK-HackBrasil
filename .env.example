# Copie para .env e preencha. NUNCA commite o .env.
DATA_MODE=simulado          # simulado | real | auto
ENGINE=python               # python | qgis
BALK_DB=balk.db

# WhatsApp Cloud API (Meta) - só para envio real
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# SMS (Twilio) - só para envio real
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# IA de redação (opcional; sem chave usa o texto fixo)
ANTHROPIC_API_KEY=
POLISH_MODEL=claude-haiku-5-5
