# Copie para .env e preencha. NUNCA commite o .env. Para conferir tudo: python -m app.cli check

# --- ambiente ---------------------------------------------------------------
# BALK_ENV: só "dev" ou "production" (outro valor impede de subir). Sem a variável vale "dev", que LIGA o simulador, /outbox
# (mostra os códigos de verificação) e a rota que apaga o banco: use só na sua máquina. Em servidor, SEMPRE production.
# BALK_ENV=production
DATA_MODE=simulado           # simulado (demo, offline) | real | auto (tenta real, cai para cache e depois simulado)
ENGINE=python                # python | qgis (qgis só dentro da imagem do QGIS)
BALK_DB=balk.db
BALK_WORK=work
LOG_LEVEL=INFO

# --- segurança (obrigatórias em production) ---------------------------------
BALK_API_KEY=                # 24+ caracteres aleatórios; o n8n manda no header X-API-Key. Gere: python -c "import secrets;print(secrets.token_urlsafe(32))"
BALK_AUTH_SECRET=            # 24+ caracteres aleatórios; protege (HMAC) os códigos de verificação do site. Obrigatório em production
PUBLIC_BASE_URL=http://localhost:8000   # em production: https://seu-dominio (os links do relatório e do mapa saem daqui; com https o cookie vira Secure)
MAPTILER_KEY=                # chave do MapTiler (plano gratuito: teste e uso NÃO comercial): liga o fundo de SATÉLITE no mapa do site. Restrinja a chave ao seu domínio no painel
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # camada "Ruas" do mapa (OSM serve a demo; uso em escala exige provedor próprio, OPERACAO.md)
MAP_TILES_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILES_MAXZOOM=19
REPORT_TTL_DAYS=30           # por quantos dias o link do relatório detalhado vale
CSV_REQUIRES_OPTIN=          # vazio = automático (production: SIM exigido de cada produtor do CSV; dev: vale a declaração da cooperativa). 1 ou 0 força
SMS_INCLUDE_LINK=0          # 1 = põe o link no SMS quando couber nos 160 caracteres (o projeto prevê SMS sem link)

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
WHATSAPP_TOKEN=              # token de acesso permanente
WHATSAPP_PHONE_ID=           # ID do número
WHATSAPP_APP_SECRET=         # segredo do app: valida X-Hub-Signature-256 (obrigatório com WHATSAPP_TOKEN)
WHATSAPP_VERIFY_TOKEN=       # texto que você inventa e cola no painel da Meta ao cadastrar o webhook
WHATSAPP_TEMPLATE_NAME=      # template de UTILIDADE aprovado (1 variável no corpo) para alertas proativos
WHATSAPP_CODE_TEMPLATE_NAME= # template de AUTENTICAÇÃO (código de verificação do site); sem ele cai no geral
WHATSAPP_INVITE_TEMPLATE_NAME= # template do convite ao segundo contato; sem ele cai no geral
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=           # também valida X-Twilio-Signature do webhook /sms/inbound
TWILIO_FROM=

# --- IA de redação (opcional; sem chave usa o texto fixo) --------------------
ANTHROPIC_API_KEY=
POLISH_MODEL=claude-haiku-5-5
USE_AI_POLISH=1
