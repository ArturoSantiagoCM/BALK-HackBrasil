{
  "name": "BALK WF2 Diário (alertas do dia)",
  "nodes": [
    {
      "name": "Todo dia 06:05",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 6 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "GET /producers/active",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/producers/active",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Um produtor por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "name": "POST /analyze/{id}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/analyze/{{$json.id}}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Alertas da análise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const r = $json; const out = [];\nconst alerts = r.messages.filter(m => m.kind === 'alert');\nalerts.forEach(m => out.push({json: {producer_id: r.producer_id, phone: r.phone, channel: r.channel, type: m.type, text: m.text}}));\nreturn out;"
      }
    },
    {
      "name": "Canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "whatsapp",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.channel}}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "sms"
            }
          ]
        }
      }
    },
    {
      "name": "Enviar WhatsApp (Meta Cloud API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"text\",\"text\":{\"body\":{{JSON.stringify($json.text)}}}}"
      }
    },
    {
      "name": "Enviar SMS (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1460,
        80
      ],
      "parameters": {
        "operation": "send",
        "from": "={{$env.TWILIO_FROM}}",
        "to": "={{$json.phone}}",
        "message": "={{$json.text}}"
      }
    },
    {
      "name": "POST /alerts/log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/alerts/log",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"producer_id\": {{$(\"Alertas da análise\").item.json.producer_id}}, \"type\": \"{{$(\"Alertas da análise\").item.json.type}}\"}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Avisar equipe (erro)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.ALERT_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"BALK: falha em \" + $workflow.name}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    }
  ],
